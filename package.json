{
  "name": "chat-next",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && pnpm check:brand",
    "check:brand": "check-brand --config brand.config.json --dir apps --dir packages --dir server --dir proto --dir sdk --dir spec --dir deploy --skip-dir gen --banned chat-inet --test-file '/test/|_test\\.go$|\\.test\\.ts$' --hint 'read it from @shared-next/brand'",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "perf": "pnpm --filter @app/web perf",
    "e2e": "node apps/web/test/e2e/run.ts",
    "proto:lint": "buf lint proto",
    "proto:breaking": "buf breaking proto --against '.git#branch=main,subdir=proto'",
    "proto:gen": "buf generate proto --template proto/buf.gen.yaml",
    "brand:gen": "pnpm --filter @app/web brand:gen",
    "sdk:gen": "cd server && go run ./cmd/sdkgen",
    "conformance:sdk": "cd server && SDK_CONFORMANCE=1 go test -count=1 -run TestSDKConformance ./internal/api/"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@eslint/js": "10.0.1",
    "@shared-next/brand": "github:achoo254/shared-next#v0.2.0&path:/packages/brand",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
