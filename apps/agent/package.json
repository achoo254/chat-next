{
  "name": "@achoo254/chat-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Background agent on a user's own machine: runs their installed AI coding CLI and relays it, end-to-end encrypted, to their paired devices",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "bun src/cli.ts run",
    "spike": "bun src/spike.ts"
  },
  "dependencies": {
    "@achoo254/chat-proto": "workspace:*",
    "@achoo254/chat-remote-protocol": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@bufbuild/protobuf": "2.16.0",
    "ws": "8.18.3",
    "@tunelo/client": "github:achoo254/localman-next#tunelo-client-v0.1.0&path:/packages/tunelo-client"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
