{
  "name": "@achoo254/tunelo-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Background process on a user's own machine: tunnels to localhost (the Tunelo CLI), and their installed AI coding CLI relayed end-to-end encrypted to their paired devices",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "bun src/cli.ts run",
    "spike": "bun src/spike.ts"
  },
  "dependencies": {
    "@achoo254/chat-proto": "workspace:*",
    "@achoo254/chat-remote-protocol": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@bufbuild/protobuf": "2.16.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@tunelo/client": "github:achoo254/localman-next#tunelo-client-v0.3.2&path:/packages/tunelo-client",
    "@tunelo/shared": "github:achoo254/localman-next#tunelo-shared-v0.2.1&path:/packages/tunelo-shared",
    "chalk": "5.6.2",
    "commander": "12.1.0",
    "ws": "8.18.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "esbuild": "0.27.7"
  }
}
