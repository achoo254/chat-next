# /opt/chat/.env on the server (root:chat, 640). Never synced from a dev
# machine; setup-server.sh fills the defaults and generated secrets.
CHAT_ENV=production
CHAT_LISTEN_ADDR=127.0.0.1:4600
CHAT_PUBLIC_URL=https://chat.hoandat.com
# Shared PostgreSQL on the server, own role/database (setup-server.sh).
DATABASE_URL=
OIDC_ISSUER=https://auth.hoandat.com
OIDC_CLIENT_ID=chat-web
# Same value as CHAT_WEB_CLIENT_SECRET in /var/www/hoandat-auth/.env.
OIDC_CLIENT_SECRET=
# base64, at least 32 bytes (AES-256-GCM for refresh tokens and the login cookie).
SESSION_KEY=
# Only while rotating SESSION_KEY (infra/chat/rotate-session-key.sh): the old
# key, still accepted to open stored values and verify tokens.
# SESSION_KEY_PREVIOUS=
# The domain the service runs under, returned to clients as tenant_name.
TENANT_DOMAIN=hoandat.com
# Optional: the app's own URL scheme allowed in message links (brand urlScheme).
# APP_URL_SCHEME=com.hoandat.chat
# off turns the iOS/Android app's sign-in off (docs/mobile-app.md).
# NATIVE_SIGN_IN=on
# Comma-separated user ids allowed to use the moderation queue; empty = nobody.
CHAT_OPERATOR_USER_IDS=
# Addresses (or CIDR ranges) that bot webhooks and link previews never call:
# this server's own public address, so a URL cannot reach the other sites
# hosted here. The public addresses of the host's interfaces are refused too.
OUTBOUND_DENY_CIDRS=<SERVER_65_IP>
# Optional anti-spam thresholds (defaults shown; 0 turns a rule off). New
# private chats with strangers per 24 h for accounts younger than
# ABUSE_NEW_ACCOUNT_DAYS, and for older ones; distinct reporters with open
# reports that pause new chats with strangers; new chat accounts per address
# per hour and per tenant per 10 minutes at first sign-in.
# ABUSE_STRANGER_CHATS_NEW=20
# ABUSE_STRANGER_CHATS=50
# ABUSE_NEW_ACCOUNT_DAYS=7
# ABUSE_REPORTERS=3
# ABUSE_SIGNUPS_PER_IP_HOUR=30
# ABUSE_SIGNUPS_PER_10MIN=300
# People online at once in this process (load test round 1); 0 = no cap.
# CHAT_MAX_ONLINE_USERS=1000
# Web Push (notifications of the installed web app while it is closed).
# P-256 private key, base64url; generated once on the server by
# generate-vapid-key.sh (setup-server.sh runs it), never replaced (browsers
# subscribed with the old key would stop getting pushes). Unset = Web Push
# off (the app hides the option). Left commented here so the generator
# adds it.
# WEB_PUSH_VAPID_PRIVATE_KEY=
# Optional: contact push services see (mailto: or https:); default
# CHAT_PUBLIC_URL.
# WEB_PUSH_SUBJECT=mailto:ops@hoandat.com


# Media (R3). Unset MEDIA_PUBLIC_URL = media off (attaching hidden in the app).
# Download and upload host (nginx media-chat.hoandat.com.conf); never the chat host.
MEDIA_PUBLIC_URL=https://media-chat.hoandat.com
# Files on this server (default storage). activate-release.sh creates the
# directory chat:chat 0750.
MEDIA_STORAGE=filesystem
MEDIA_ROOT=/opt/chat/media
# Uploads are refused (and an error logged) while less than this would stay
# free on the media disk (default 5 GiB).
MEDIA_MIN_FREE_BYTES=5368709120
# Personal data exports (ZIP, kept 30 days): by default MEDIA_ROOT/exports with
# the filesystem storage (the app creates it chat:chat 0750); with S3 storage
# set it, or exports stay off. An export build also keeps MEDIA_MIN_FREE_BYTES
# free on this disk.
# DATA_EXPORT_DIR=/opt/chat/media/exports
# Shared server: 512 MiB per file (code default 2000 MiB), 10 GiB per user
# (code default 20 GiB).
MEDIA_UPLOAD_MAX_BYTES=536870912
MEDIA_USER_QUOTA_BYTES=10737418240
# Optional: ffmpeg for video posters and voice waveforms, e.g. /usr/bin/ffmpeg.
# MEDIA_FFMPEG_PATH=
#
# Later move to S3-compatible storage (iNET Object Storage): set
# MEDIA_STORAGE=s3 and
# MEDIA_S3_ENDPOINT=https://drive-storagehns3st.000nethost.com
# MEDIA_S3_REGION=hn-storage
# MEDIA_S3_BUCKET=chat-media
# MEDIA_S3_PATH_STYLE=true
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# MEDIA_UPLOAD_MODE=proxy   (direct needs bucket CORS; see deployment guide)
