# /opt/chat/.env on the server (root:chat, 640). Never synced from a dev
# machine; setup-server.sh fills the defaults and generated secrets.
CHAT_ENV=production
CHAT_LISTEN_ADDR=127.0.0.1:4600
CHAT_PUBLIC_URL=https://chat.hoandat.com
# Shared PostgreSQL on the server, own role/database (setup-server.sh).
DATABASE_URL=
OIDC_ISSUER=https://auth.hoandat.com
OIDC_CLIENT_ID=chat-web
# Same value as CHAT_WEB_CLIENT_SECRET in /var/www/hoandat-auth/.env.
OIDC_CLIENT_SECRET=
# base64, at least 32 bytes (AES-256-GCM for refresh tokens and the login cookie).
SESSION_KEY=
TENANT_ID=primary
TENANT_DOMAIN=hoandat.com
