{
  "name": "@achoo254/chat-core",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first chat client core: sync engine, outbox, local SQLite store, realtime transport, media and local search; platform-agnostic",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@achoo254/chat-platform": "workspace:*",
    "@achoo254/chat-proto": "workspace:*",
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0"
  }
}
