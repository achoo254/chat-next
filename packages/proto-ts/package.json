{
  "name": "@achoo254/chat-proto",
  "version": "0.1.0",
  "description": "Protobuf-ES messages and Connect service descriptors of the chat API (proto/app/v1), generated by buf",
  "license": "MIT",
  "author": "achoo254",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achoo254/chat-next.git",
    "directory": "packages/proto-ts"
  },
  "homepage": "https://github.com/achoo254/chat-next/tree/main/packages/proto-ts#readme",
  "bugs": {
    "url": "https://github.com/achoo254/chat-next/issues"
  },
  "keywords": [
    "chat",
    "protobuf",
    "connectrpc",
    "protobuf-es"
  ],
  "type": "module",
  "exports": {
    "./*": "./src/gen/app/v1/*_pb.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/gen/app/v1/*_pb.d.ts",
        "default": "./dist/gen/app/v1/*_pb.js"
      },
      "./package.json": "./package.json"
    }
  }
}
