{
  "name": "@achoo254/chat-proto",
  "version": "0.0.0",
  "private": true,
  "description": "Protobuf-ES messages and Connect service descriptors of the chat API (proto/app/v1), generated by buf",
  "type": "module",
  "exports": {
    "./*": "./src/gen/app/v1/*_pb.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  }
}
