# Copy to deploy/dev/idp.env (never committed). The IdP refuses to start
# without these; see hoandat-auth/.env.example for every option.
# Create signing keys once in the hoandat-auth checkout: `pnpm generate-key`.
COOKIE_KEYS=
LOCALMAN_WEB_CLIENT_SECRET=
TUNELO_WEB_CLIENT_SECRET=
CHAT_WEB_CLIENT_SECRET=
# Sign-in needs at least one upstream; register a local OAuth app with
# redirect http://localhost:4500/oauth/google/callback (or github).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
